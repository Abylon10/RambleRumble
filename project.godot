; Engine configuration file.
; Ramble Rumble — 2D top-down mobile game, C# (Godot .NET).

config_version=5

[application]

config/name="Ramble Rumble"
config/description="Monster hunting, skills, pet collection and base raids."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[autoload]

PlayerData="*res://scripts/PlayerData.cs"

[dotnet]

project/assembly_name="RambleRumble"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.12, 1)
